#version 450
#extension GL_GOOGLE_include_directive : require

#define COMMON_BUFFERS_SET 0
#include "common/common_buffers.glsl"

#define SCENE_SET 1
#include "common/scene.glsl"

#define SINGLEDRAW_BUFFERS_SET 2
#include "common/singledraw_buffers.glsl"

#include "common/constants.glsl"

#include "common/culling_utils.glsl"

layout (local_size_x = MESHLETS_PROCESSED_PER_GROUP, local_size_y = 1, local_size_z = 1) in;
void main() {
    uint workloadId = gl_WorkGroupID.x;
    MeshletsWorkload workload = MeshletsWorkloads[workloadId];

    uint localMeshletIndex = gl_LocalInvocationID.x;
    if (workload.meshletsCount <= localMeshletIndex) {
        return;
    }

    uint meshletId = workload.startMeshlet + localMeshletIndex;
    Meshlet meshlet = Meshlets[meshletId];
    Instance instance = Instances[workload.instanceId];
    
    Frustum frustum;
    extractFrustumPlanes(Setup.cameraViewProjection, frustum);
    vec4 boundingSphere = transformBoundingSphere(instance.transform, meshlet.boundingSphere);

    if (!isSphereVisible(boundingSphere, frustum)) {
        return;
    }

    uint meshletWorkloadId = atomicAdd(Commands.dispatchPerMeshletCommand.x, 1);

    if (meshletWorkloadId >= Setup.maxWorkloadPerMeshletCount) {
        return;
    }

    PerMeshletWorkload result;
    result.instanceId = workload.instanceId;
    result.meshletId = meshletId;
    PerMeshletWorkloads[meshletWorkloadId] = result;
}