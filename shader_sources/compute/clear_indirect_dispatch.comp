#version 450
#extension GL_GOOGLE_include_directive : require

#define COMMON_BUFFERS_SET 0
#include "common/common_buffers.glsl"

layout (local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
void main()
{
    Commands.dispatchPerInstanceCommand = VkDispatchIndirectCommand(
        0u, 1u, 1u
    );
    Commands.dispatchPerMeshletCommand = VkDispatchIndirectCommand(
        0u, 1u, 1u
    );
    Commands.singleDrawIndexedCommand = VkDrawIndexedIndirectCommand(
        0, 1, 0, 0, 0
    );
    Commands.drawCommandCounter = 0;
    Commands.indexCounter = 0;
    Commands.vertexCounter = 0;
}