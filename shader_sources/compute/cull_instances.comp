#version 450
#extension GL_GOOGLE_include_directive : require

#define COMMON_BUFFERS_SET 0
#include "common/common_buffers.glsl"

#define SCENE_SET 1
#include "common/scene.glsl"

#include "common/constants.glsl"

#include "common/culling_utils.glsl"

layout (local_size_x = DEFAULT_GROUP_SIZE, local_size_y = 1, local_size_z = 1) in;
void main() {
    uint instanceId = gl_GlobalInvocationID.x;

    if (instanceId >= SceneStats.countInstances) {
        return;
    }

    Frustum frustum;
    extractFrustumPlanes(Setup.cameraViewProjection, frustum);

    Instance instance = Instances[instanceId];
    Model model = Models[instance.modelId];
    vec4 boundingSphere = transformBoundingSphere(instance.transform, model.boundingSphere);
    
    if (!isSphereVisible(boundingSphere, frustum)) {
        return;
    }
    
    uint numWorkgroups = (model.meshletCount + MESHLETS_PROCESSED_PER_GROUP - 1) / MESHLETS_PROCESSED_PER_GROUP;
    uint processedMeshlets = 0;
    
    uint beginIndex = atomicAdd(Commands.dispatchPerInstanceCommand.x, numWorkgroups);
    
    for (uint i = 0; i < numWorkgroups; i++) {

        if (beginIndex + i >= Setup.maxWorkloadPerInstanceCount) {
            return;
        }

        MeshletsWorkload load;
        load.instanceId = instanceId;
        load.startMeshlet = model.meshletStart + processedMeshlets;
        load.meshletsCount = min(MESHLETS_PROCESSED_PER_GROUP, model.meshletCount - processedMeshlets);

        MeshletsWorkloads[beginIndex + i] = load;
        processedMeshlets += load.meshletsCount;
    }
}