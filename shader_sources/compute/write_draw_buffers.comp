#version 450
#extension GL_GOOGLE_include_directive : require

#define COMMON_BUFFERS_SET 0
#include "common/common_buffers.glsl"

#define SCENE_SET 1
#include "common/scene.glsl"

#define SINGLEDRAW_BUFFERS_SET 2
#include "common/singledraw_buffers.glsl"

#include "common/constants.glsl"

shared uint VertexStartIndex;
shared uint IndexStartIndex;

layout (local_size_x = MAX_PRIMITIVES_PER_MESHLET, local_size_y = 1, local_size_z = 1) in;
void main() {
    uint workloadId = gl_WorkGroupID.x;

    if (Setup.maxWorkloadPerMeshletCount <= workloadId) {
        return;
    }

    PerMeshletWorkload workload = PerMeshletWorkloads[workloadId];

    Meshlet meshlet = Meshlets[workload.meshletId];

    uint indexCount = meshlet.packedIndexVertexCount & 0xFFFF;   
    uint vertexCount = (meshlet.packedIndexVertexCount >> 16) & 0xFFFF;

    if (gl_LocalInvocationID.x == 0) {
        VertexStartIndex = atomicAdd(Commands.vertexCounter, vertexCount);
        IndexStartIndex = atomicAdd(Commands.indexCounter, indexCount);
    }   

    barrier();

    if (VertexStartIndex + vertexCount >= Setup.maxVertexCount ||
        IndexStartIndex + indexCount >= Setup.maxIndexCount) 
    {
        return;
    }

    // write vertices
    if (vertexCount > gl_LocalInvocationID.x) {
        uint writeIndex = VertexStartIndex + gl_LocalInvocationID.x;
        uint readIndex = MeshletUnuqueVertices[meshlet.uniqueVerticesStart + gl_LocalInvocationID.x];
        
        uvec4 vertex = Vertices[readIndex];
        vertex.w = workload.instanceId;

        CulledVertices[writeIndex] = vertex;
    }

    // write indices
    if (indexCount > gl_LocalInvocationID.x) {
        uint writeIndex = IndexStartIndex + gl_LocalInvocationID.x;
        uint localVertexIndex = MeshletLocalIndices[meshlet.localIndicesStart + gl_LocalInvocationID.x];
        uint globalVertexIndex = localVertexIndex + VertexStartIndex;

        CulledIndices[writeIndex] = globalVertexIndex;
    }

    // update draw command
    if (gl_LocalInvocationID.x == 0) {
        atomicAdd(Commands.singleDrawIndexedCommand.indexCount, indexCount);
    }
}