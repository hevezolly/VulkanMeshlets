cmake_minimum_required(VERSION 3.20)

if(NOT IS_DIRECTORY "${RESOURCE_PROJECT_DIR}" OR NOT IS_ABSOLUTE "${RESOURCE_OUTPUT_DIR}")
    message(FATAL_ERROR "Expected a project directory and an absolute resource output path.")
endif()

file(MAKE_DIRECTORY "${RESOURCE_OUTPUT_DIR}")
file(REAL_PATH "${RESOURCE_PROJECT_DIR}" project_dir)
file(REAL_PATH "${RESOURCE_OUTPUT_DIR}" build_output_dir)

foreach(resource IN ITEMS assets shaders)
    set(source_dir "${project_dir}/${resource}")
    set(output_dir "${build_output_dir}/${resource}")
    cmake_path(IS_PREFIX output_dir "${project_dir}" contains_project)
    if(contains_project OR IS_SYMLINK "${output_dir}")
        message(FATAL_ERROR "Refusing to clear resource output: ${output_dir}")
    endif()
    if(EXISTS "${output_dir}")
        file(REAL_PATH "${output_dir}" resolved_output)
        if(NOT resolved_output STREQUAL output_dir OR NOT IS_DIRECTORY "${output_dir}")
            message(FATAL_ERROR "Unexpected resource output directory: ${output_dir}")
        endif()
    endif()

    if(IS_DIRECTORY "${source_dir}")
        file(REAL_PATH "${source_dir}" resolved_source)
        cmake_path(IS_PREFIX resolved_source "${output_dir}" output_in_source)
        cmake_path(IS_PREFIX output_dir "${resolved_source}" source_in_output)
        if(output_in_source OR source_in_output)
            message(FATAL_ERROR "Resource source and output overlap: ${source_dir} and ${output_dir}")
        endif()
    endif()
endforeach()

foreach(resource IN ITEMS assets shaders)
    set(source_dir "${project_dir}/${resource}")
    set(output_dir "${build_output_dir}/${resource}")
    file(REMOVE_RECURSE "${output_dir}") # not the most optimal way, but easiest to implement
    if(IS_DIRECTORY "${source_dir}")
        file(COPY "${source_dir}/" DESTINATION "${output_dir}")
    else()
        file(MAKE_DIRECTORY "${output_dir}")
    endif()
endforeach()
